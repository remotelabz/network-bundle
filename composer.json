{
    "name": "remotelabz/network-bundle",
    "description": "NetworkBundle is a bundle used by RemoteLabz to handle all IP and network related aspects.",
    "type": "symfony-bundle",
    "require": {
        "php": "^7.3|^8.0",
        "jms/serializer": "^3.32",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^3.4",
        "doctrine/dbal": "^4.2"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^5.1",
        "squizlabs/php_codesniffer": "3.*"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Remotelabz\\NetworkBundle\\": ""
        },
        "exclude-from-classmap": [
            "Resources/",
            "Tests/"
        ]
    },
    "authors": [
        {
            "name": "Julien Hubert",
            "email": "julien.hubert1@univ-reims.fr"
        },
        {
            "name": "Florent Nolot",
            "email": "florent.nolot@univ-reims.fr"
        }
    ]
}
